.DS_Store

# Xcode
*.xcuserstate
*.xcuserdatad/
*.xcscheme
xcuserdata/
DerivedData/
**/.swiftpm/xcode/

# User-specific Xcode files
**/*.xcodeproj/xcuserdata/
**/*.xcodeproj/project.xcworkspace/xcuserdata/
**/*.xcworkspace/xcuserdata/

# Breakpoints and user interface state
*.xcbkptlist
**/**/UserInterfaceState.xcuserstate
**/IDEWorkspaceChecks.plist
**/WorkspaceSettings.xcsettings
**/IDEFindNavigatorScopes.plist

# Scheme management (keep shared schemes, ignore user schemes)
**/*.xcodeproj/xcshareddata/xcschemes/*.xcscheme
!**/*.xcodeproj/xcshareddata/xcschemes/*Shared*.xcscheme

# Build products
build/
Build/
.build/
*.dSYM.zip
*.dSYM

# Configuration files with sensitive data
*.xcconfig
!*.xcconfig.template
Development.xcconfig
Production.xcconfig

# Local StoreKit sandbox. Product IDs must match BUNDLE_IDENTIFIER.
# Copy Pulse/Products.storekit.template and rewrite the prefix.
Pulse/Products.storekit

# Xcode project user data
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
xcuserdata/
project.xcworkspace/xcuserdata/

# Claude Code / AI assistant local state. Never commit.
.claude/
CLAUDE.md

# Session dev logs are output as text for the operator, never committed.
docs/devlog/

# Working plans. ADRs under docs/architecture/ are the public record.
docs/plans/

# Grok / other agent session scratch (if ever created under the repo root).
.grok/

# Agent task prompts and companion handoff files — local only, never ship.
*AGENT_PROMPT.md
WEB_COMPANION_AGENT_PROMPT.md
AGENTS.md

# Instruments captures (Time Profiler, etc.) — operator machine only.
*.trace

# Local environment and secrets. Tokens live in the operator shell, not the tree.
.env
.env.*

# Unfiltered lab schema (~5.5 MiB). Regeneration fetches it; only the filtered
# document is vendored.
docs/netbox/openapi-raw.yaml
