// Apple Developer Team ID - find this in your Apple Developer account.
// Keep this file local (gitignored). Do not paste the Team ID into
// project.pbxproj — Xcode Automatic signing will try; restore the
// project file rather than committing the literal.
DEVELOPMENT_TEAM = YOUR_TEAM_ID_HERE

// Base bundle identifier for your app
BUNDLE_IDENTIFIER = com.yourorg.pulse

// App Store marketing version (CFBundleShortVersionString) and build (CFBundleVersion)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 2026.09.04

// Public site for in-app Privacy / Terms links. Leave empty to derive
// from BUNDLE_IDENTIFIER (com.yourorg.pulse → yourorg.com/pulse/privacy).
MARKETING_HOST =

// For Xcode StoreKit testing, copy Pulse/Products.storekit.template to
// Pulse/Products.storekit and prefix every productID with BUNDLE_IDENTIFIER.
