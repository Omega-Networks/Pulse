<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Transport Security.
	  - NSAllowsLocalNetworking permits plain HTTP and self-signed TLS on the
	    local network (the common internal-deployment shape for NetBox and Zabbix).
	  - NSAllowsArbitraryLoadsInWebContent relaxes ATS for WKWebView content ONLY
	    (the Device Web companion). Appliance web UIs are routinely served over
	    self-signed TLS, and an appliance reached by a PUBLIC IP is not covered by
	    NSAllowsLocalNetworking, so ATS would otherwise refuse its certificate with
	    NSURLErrorServerCertificateUntrusted (-1202) even after the operator
	    accepts it (observed on a public FortiGate at :9443 whose cert is otherwise
	    valid). This flag scopes the relaxation to web content; the app's own
	    NetBox / Zabbix URLSession traffic stays under full ATS. Untrusted
	    certificates are still gated by the operator trust prompt
	    (TLSTrustCoordinator), so this loosens transport policy, not the TOFU trust
	    decision.
	  Operators whose NetBox / Zabbix lives on a public IP with a non-trusted cert
	  can add a per-domain URLSession exception via NSExceptionDomains here, e.g.:

	      <key>NSExceptionDomains</key>
	      <dict>
	        <key>netbox.example.org</key>
	        <dict>
	          <key>NSExceptionAllowsInsecureHTTPLoads</key>
	          <true/>
	        </dict>
	      </dict>
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<!--
	  Local Network privacy (macOS 15+). The Device Web companion and the SSH
	  terminal connect to appliances on the operator's local network by private
	  IP; macOS gates those connections behind a Local Network permission and
	  fails them with NSURLErrorCannotConnectToHost (-1004) until the operator
	  grants access. This usage string is what macOS shows in that prompt.
	  NetBox / Zabbix over a routed hostname do not trip this gate; a WKWebView
	  reaching a local appliance does.
	-->
	<!--
	  Optional public host for Privacy / Terms. Empty means derive from
	  PRODUCT_BUNDLE_IDENTIFIER (see PulseDistribution.marketingHost).
	-->
	<key>PulseMarketingHost</key>
	<string>$(MARKETING_HOST)</string>
	<!--
	  Export compliance is INFOPLIST_KEY_ITSAppUsesNonExemptEncryption on the
	  Pulse target (NO: Connect requires no documentation upload).
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pulse connects to devices on your local network to open their web and terminal management interfaces.</string>
	<key>UIBackgroundModes</key>
	<array/>
</dict>
</plist>
