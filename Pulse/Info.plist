<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Transport Security. NSAllowsLocalNetworking permits plain
	  HTTP and self-signed TLS on the local network (the common
	  internal-deployment shape for NetBox and Zabbix); external
	  traffic still goes through standard ATS. Operators whose
	  NetBox / Zabbix lives on a public IP with a non-trusted cert
	  can add a per-domain exception via NSExceptionDomains here, e.g.:

	      <key>NSExceptionDomains</key>
	      <dict>
	        <key>netbox.example.org</key>
	        <dict>
	          <key>NSExceptionAllowsInsecureHTTPLoads</key>
	          <true/>
	        </dict>
	      </dict>

	  Per-server explicit trust settings (strict / accept self-signed
	  / allow insecure, per-endpoint, logged) is the right long-term
	  direction; queued as a future slice.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!--
	  Local Network privacy (macOS 15+). The Device Web companion and the SSH
	  terminal connect to appliances on the operator's local network by private
	  IP; macOS gates those connections behind a Local Network permission and
	  fails them with NSURLErrorCannotConnectToHost (-1004) until the operator
	  grants access. This usage string is what macOS shows in that prompt.
	  NetBox / Zabbix over a routed hostname do not trip this gate; a WKWebView
	  reaching a local appliance does.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pulse connects to devices on your local network to open their web and terminal management interfaces.</string>
	<key>UIBackgroundModes</key>
	<array/>
</dict>
</plist>
